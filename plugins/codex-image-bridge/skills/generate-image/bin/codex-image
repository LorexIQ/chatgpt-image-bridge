#!/usr/bin/env bash
# Генерирует изображение встроенным инструментом image_generation из Codex CLI.
# Работает через авторизацию ChatGPT в codex — API-ключ OpenAI не нужен.
#
# Использование: codex-image "<промпт>" <выход.png> [--size WxH] [--image <файл>]...
#
# Без --size модель сама выбирает размер.
# --image прикладывает исходную или референсную картинку (можно несколько раз).
# Работает на macOS, Linux и Windows (Git Bash или WSL).

set -euo pipefail

usage='использование: codex-image "<промпт>" <выход.png> [--size WxH] [--image <файл>]...'

if [[ $# -lt 2 ]]; then
  echo "$usage" >&2
  exit 2
fi

prompt="$1"
out="$2"
shift 2

# На Windows (Git Bash) и codex, и инструмент Read в Claude Code — нативные
# программы, POSIX-пути вида /tmp/... им непонятны, поэтому отдаём пути C:/...
native_path() {
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -m "$1"
  else
    printf '%s\n' "$1"
  fi
}

size=""
images=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --size)
      if [[ $# -lt 2 ]]; then
        echo "codex-image: для --size нужно значение (WxH, например 1536x1024)" >&2
        exit 2
      fi
      size="$2"; shift 2 ;;
    --image)
      if [[ $# -lt 2 ]]; then
        echo "codex-image: для --image нужен путь к файлу" >&2
        exit 2
      fi
      images+=("$2"); shift 2 ;;
    *) echo "codex-image: неизвестный аргумент: $1" >&2; exit 2 ;;
  esac
done

if [[ -n "$size" && ! "$size" =~ ^[0-9]+x[0-9]+$ ]]; then
  echo "codex-image: --size должен быть в формате WxH (например 1536x1024), получено: $size" >&2
  exit 2
fi

if ! command -v codex >/dev/null 2>&1; then
  echo "codex-image: codex CLI не найден в PATH. Установите его (npm install -g @openai/codex или brew install codex) и выполните codex login." >&2
  exit 127
fi

out_dir="$(cd "$(dirname "$out")" 2>/dev/null && pwd)" || {
  echo "codex-image: папка для результата не существует: $(dirname "$out")" >&2
  exit 2
}
out="$out_dir/$(basename "$out")"

# Codex работает во временной папке, поэтому пути к картинкам нужны абсолютные.
codex_images=()
image_paths=""
for img_in in ${images[@]+"${images[@]}"}; do
  if [[ ! -f "$img_in" ]]; then
    echo "codex-image: картинка не найдена: $img_in" >&2
    exit 2
  fi
  img_native="$(native_path "$(cd "$(dirname "$img_in")" && pwd)/$(basename "$img_in")")"
  codex_images+=(-i "$img_native")
  image_paths+="
- ${img_native}"
done

codex_home="${CODEX_HOME:-$HOME/.codex}"
if command -v cygpath >/dev/null 2>&1; then
  codex_home="$(cygpath -u "$codex_home")"
fi

# Для картинки агентная обвязка codex не нужна, а каждая её часть стоит времени
# на старте или токенов в промпте на каждом вызове. Замер на codex-cli 0.154 с
# локальным сервером-перехватчиком: запрос к модели уменьшается с ~86 КБ до
# ~46 КБ, процессы MCP и плагинов не запускаются. Намеренно оставлены:
# image_generation, code_mode_host (инструмент картинок доступен только через
# code mode), сжатие запросов и хранилище авторизации.
#
# Shell и patch-инструменты тоже выключены — подделать PNG codex нечем.
# Без `unbounded_connection_retries` сетевая ошибка завершает вызов, а не
# крутит переподключения до таймаута вызывающего.
unneeded_features=(
  apps auth_elicitation browser_use browser_use_external browser_use_full_cdp_access
  computer_use goals guardian_approval hooks in_app_browser in_app_chat
  in_app_dictation in_app_local_automation in_app_updates mentions_v2 multi_agent
  personality plugin_sharing plugins remote_plugin shell_snapshot shell_tool
  skill_mcp_dependency_install skill_search sleep_tool tool_call_mcp_elicitation
  tool_suggest unbounded_connection_retries unified_exec unified_exec_tty
  view_image workspace_dependencies
)
# `--disable` падает на именах, которых эта версия codex не знает, поэтому
# передаём только фичи из её списка.
known_features=" $(codex features list 2>/dev/null | tr -d '\r' | awk '{print $1}' | tr '\n' ' ') "
codex_flags=()
for feature in "${unneeded_features[@]}"; do
  if [[ "$known_features" == *" $feature "* ]]; then
    codex_flags+=(--disable "$feature")
  fi
done

codex_flags+=(
  -c 'web_search="disabled"'
  -c 'notify=[]'
  -c project_doc_max_bytes=0
  -c memories.use_memories=false
  -c memories.generate_memories=false
  -c analytics.enabled=false
  -c feedback.enabled=false
  -c 'history.persistence="none"'
  -c check_for_update_on_startup=false
  -c skills.bundled.enabled=false
)

# У MCP-серверов из конфига нет общего выключателя — отключаем каждый по имени.
# Список берём с выключенными плагинами, иначе серверы плагинов превратились бы
# в битые записи конфига.
while IFS= read -r server; do
  codex_flags+=(-c "mcp_servers.${server}.enabled=false")
done < <(codex --disable plugins mcp list --json 2>/dev/null | tr -d '\r' |
  sed -n 's/^    "name": "\([A-Za-z0-9_-]*\)",\{0,1\}$/\1/p')

# То же с пользовательскими скиллами: иначе их описания раздувают промпт, а
# некоторые («используй перед любой творческой работой») уводят модель от картинки.
skill_entries=""
while IFS= read -r skill; do
  skill_entries+="${skill_entries:+, }{name=\"${skill}\", enabled=false}"
done < <(find "$codex_home/skills" "$HOME/.agents/skills" -maxdepth 4 -name SKILL.md 2>/dev/null |
  while IFS= read -r skill_md; do sed -n '1,15s/^name:[[:space:]]*//p' "$skill_md" | head -n 1; done |
  tr -d '\r' | sed 's/[[:space:]]*$//; s/^"\(.*\)"$/\1/; s/^'\''\(.*\)'\''$/\1/' |
  grep -E '^[A-Za-z0-9_.:-]+$' | LC_ALL=C sort -u)
if [[ -n "$skill_entries" ]]; then
  codex_flags+=(-c "skills.config=[${skill_entries}]")
fi

size_line=""
if [[ -n "$size" ]]; then
  size_line="
SIZE: ${size}"
fi

images_line=""
if [[ -n "$image_paths" ]]; then
  images_line="
INPUT IMAGES (also attached to this message) — pass these paths to the image tool as referenced_image_paths and use them as the prompt describes:${image_paths}"
fi

workdir="$(mktemp -d "${TMPDIR:-/tmp}/codex-image.XXXXXX")"
# Лог лежит рядом с рабочей папкой, а не внутри: на Windows фоновые сканеры
# могут держать открытый лог, и это не должно мешать удалить папку.
log="${workdir}.log"
keep_log=0
codex_pid=""

# Выполняется при любом выходе — успех, ошибка, Ctrl+C или таймаут агента (TERM).
# Уборка не критична: занятый временный файл не должен превращать удачную
# генерацию в ошибку. Лог остаётся, только если на него указывает сообщение.
cleanup() {
  if [[ -n "$codex_pid" ]] && kill -0 "$codex_pid" 2>/dev/null; then
    # На Windows codex — дерево нативных процессов, обычный kill до него не достаёт.
    if [[ -r "/proc/$codex_pid/winpid" ]] && command -v taskkill >/dev/null 2>&1; then
      taskkill //F //T //PID "$(cat "/proc/$codex_pid/winpid")" >/dev/null 2>&1 || true
    fi
    kill "$codex_pid" 2>/dev/null || true
  fi
  rm -rf "$workdir" 2>/dev/null || true
  if [[ $keep_log -eq 0 ]]; then
    rm -f "$log" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

fail() {
  keep_log=1
  echo "codex-image: $1 Последние 30 строк лога:" >&2
  tail -n 30 "$log" >&2
  echo "(полный лог: $(native_path "$log"))" >&2
  exit 1
}

# Промпт для модели codex намеренно на английском: это инструкция модели с
# именами инструментов и параметров, пользователю он не показывается.
full_prompt="Use your image_generation tool to create an image.

PROMPT: ${prompt}${size_line}${images_line}

Requirements:
- You MUST call the image_generation tool.
- Do NOT write a Python script, shell out to curl, or fabricate a PNG any other way.
- Do NOT create, copy, or move any files yourself — the generated image is collected automatically.
- Reply with only: done"

# Картинки идут после промпта: -i принимает несколько значений и иначе съел бы
# промпт как ещё один файл. Codex работает в фоне, чтобы ловушки сигналов выше
# срабатывали, пока он занят.
codex exec "${codex_flags[@]}" --skip-git-repo-check -s workspace-write -C "$(native_path "$workdir")" \
  "$full_prompt" ${codex_images[@]+"${codex_images[@]}"} </dev/null >"$log" 2>&1 &
codex_pid=$!
if ! wait "$codex_pid"; then
  codex_pid=""
  fail "codex exec завершился с ошибкой."
fi
codex_pid=""

# Доверяем только картинкам, которые сохранил сам инструмент image_generation —
# codex кладёт их в $CODEX_HOME/generated_images/<session id>/. PNG, созданный
# моделью любым другим способом, игнорируется.
session="$(sed -n 's/^session id: *//p' "$log" | head -n 1 | tr -d '\r')"
gen_dir="$codex_home/generated_images/$session"

img=""
if [[ -n "$session" && -d "$gen_dir" ]]; then
  img="$(ls -t "$gen_dir"/*.png 2>/dev/null | head -n 1 || true)"
fi

if [[ -z "$img" ]]; then
  fail "codex завершился, но инструмент image_generation не сохранил картинку в $(native_path "$gen_dir") — PNG, созданные иначе, не принимаются."
fi

cp "$img" "$out"
native_path "$out"
